<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ActivityTracker.App.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ActivityTracker.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        x:Name="RootWindow"
        Width="480" Height="480" CanResize="False"
        Title="Settings">

    <Design.DataContext>
        <vm:SettingsViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="18">

            <StackPanel>
                <TextBlock Text="IDLE DETECTION" FontSize="11" FontWeight="Bold" Opacity="0.55" Margin="0,0,0,8" />
                <StackPanel Classes="card" Spacing="8">
                    <TextBlock Text="Tracking auto-pauses after this much time with no keyboard/mouse activity, and logs the gap as idle time." FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,60">
                        <Slider Grid.Column="0" Minimum="30" Maximum="900" Value="{Binding IdleThresholdSeconds}" />
                        <TextBlock Grid.Column="1" Text="{Binding IdleThresholdSeconds, StringFormat='{}{0:0}s'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="IDLE RESUME PROMPT" FontSize="11" FontWeight="Bold" Opacity="0.55" Margin="0,0,0,8" />
                <StackPanel Classes="card" Spacing="8">
                    <CheckBox Content="Ask when I return from a long idle stretch" IsChecked="{Binding IdlePromptEnabled}" />
                    <TextBlock Text="If you've been idle longer than this, a popup asks whether to count that time as work or leave it as idle." FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,60">
                        <Slider Grid.Column="0" Minimum="60" Maximum="1800" Value="{Binding IdlePromptThresholdSeconds}" IsEnabled="{Binding IdlePromptEnabled}" />
                        <TextBlock Grid.Column="1" Text="{Binding IdlePromptThresholdSeconds, StringFormat='{}{0:0}s'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="EXCLUDED APPS" FontSize="11" FontWeight="Bold" Opacity="0.55" Margin="0,0,0,8" />
                <StackPanel Classes="card" Spacing="8">
                    <TextBlock Text="Apps listed here are never tracked." FontSize="11" Opacity="0.7" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" PlaceholderText="App name (e.g. 1Password)" Text="{Binding NewExcludedApp}" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddExcludedAppCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ExcludedApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remove"
                                            Command="{Binding #RootWindow.((vm:SettingsViewModel)DataContext).RemoveExcludedAppCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <Window.Styles>
        <Style Selector="StackPanel.card">
            <Setter Property="Background" Value="#0A000000" />
        </Style>
    </Window.Styles>
</Window>
